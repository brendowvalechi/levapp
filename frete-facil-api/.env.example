# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Levapp API
ENVIRONMENT=development          # development | production
SECRET_KEY=changeme-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# URL pública da API (usada nos callbacks do Mercado Pago)
APP_BASE_URL=http://localhost:8000

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=fretefacil
POSTGRES_PASSWORD=fretefacil123
POSTGRES_DB=fretefacil

DATABASE_URL=postgresql+asyncpg://fretefacil:fretefacil123@localhost:5432/fretefacil
DATABASE_URL_SYNC=postgresql+psycopg2://fretefacil:fretefacil123@localhost:5432/fretefacil

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ─── CORS (separado por vírgula) ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:19006,exp://localhost:19000

# ─── SMS (Zenvia ou Twilio) ───────────────────────────────────────────────────
SMS_PROVIDER=zenvia
ZENVIA_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Storage (Cloudflare R2 ou AWS S3) ────────────────────────────────────────
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=frete-facil
R2_PUBLIC_URL=

# ─── Firebase (push notifications) ───────────────────────────────────────────
FCM_SERVER_KEY=
FIREBASE_CREDENTIALS_JSON=

# ─── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Mercado Pago ─────────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=
